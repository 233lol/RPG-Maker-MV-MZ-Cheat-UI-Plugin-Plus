{
  "name": "rpg-maker-mv-mz-cheat-ui-plugin-dev-tools",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node tools/ensure-cheat-artifacts.mjs && tsc -p jsconfig.json",
    "test:unit": "node tools/ensure-cheat-artifacts.mjs && node --test \"tests/unit/**/*.test.mjs\"",
    "test:coverage": "node tools/ensure-cheat-artifacts.mjs && node --test --experimental-test-coverage --test-coverage-include=\"cheat-engine/www/cheat/**/*.js\" --test-coverage-exclude=\"cheat-engine/www/cheat/libs/**\" --test-coverage-exclude=\"cheat-engine/www/cheat/version.js\" \"tests/unit/**/*.test.mjs\"",
    "test:coverage:check": "node tools/ensure-cheat-artifacts.mjs && node --test --experimental-test-coverage --test-coverage-include=\"cheat-engine/www/cheat/**/*.js\" --test-coverage-exclude=\"cheat-engine/www/cheat/libs/**\" --test-coverage-exclude=\"cheat-engine/www/cheat/version.js\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=90 \"tests/unit/**/*.test.mjs\"",
    "vendor:shiki": "node tools/build-shiki.mjs",
    "vendor:shiki:dev": "node tools/build-shiki.mjs dev",
    "vendor:vuetify": "node tools/build-vuetify.mjs",
    "vendor:vuetify:dev": "node tools/build-vuetify.mjs dev",
    "vendor:vue": "node tools/copy-vue.mjs",
    "vendor:vue:dev": "node tools/copy-vue.mjs dev",
    "vendor:assets": "node tools/copy-vendor-assets.mjs",
    "vendor:assets:dev": "node tools/copy-vendor-assets.mjs dev",
    "vendor:libs": "node tools/build-vuetify.mjs && node tools/copy-vue.mjs && node tools/copy-vendor-assets.mjs",
    "test": "node tools/ensure-cheat-artifacts.mjs && node tests/run.mjs",
    "test:mv": "node tools/ensure-cheat-artifacts.mjs && node tests/run.mjs mv",
    "test:mz": "node tools/ensure-cheat-artifacts.mjs && node tests/run.mjs mz",
    "test:packaging": "node tests/run-packaging.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-oniguruma": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.44",
    "vuetify": "^4.3.1"
  },
  "packageManager": "pnpm@12.16.1"
}
